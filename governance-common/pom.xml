<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>br.com.talk.a2a</groupId>
    <artifactId>quem-autorizou-esse-agente</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>governance-common</artifactId>
  <name>Governance Common (Demo B)</name>
  <description>
    Componentes de governanca compartilhados pelos tres agentes da Demo B:
    PolicyEngine, token exchange com escopo atenuado, autorizacao antes do aceite da task,
    idempotencia por task ID, log de compensacao, verificacao de assinatura do Agent Card
    e registry curado de agentes confiaveis.
  </description>

  <dependencies>
    <dependency>
      <groupId>br.com.talk.a2a</groupId>
      <artifactId>a2a-spring-support</artifactId>
    </dependency>

    <dependency>
      <groupId>com.nimbusds</groupId>
      <artifactId>nimbus-jose-jwt</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
