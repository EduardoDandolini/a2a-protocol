<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>br.com.talk.a2a</groupId>
    <artifactId>quem-autorizou-esse-agente</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>a2a-spring-support</artifactId>
  <name>A2A Spring Support</name>
  <description>
    Camada de hospedagem Spring Boot para o A2A Java SDK. O SDK oficial so publica
    implementacoes de referencia baseadas em Quarkus/CDI (a2a-java-sdk-reference-jsonrpc),
    entao aqui montamos os mesmos componentes (TaskStore, QueueManager, MainEventBusProcessor,
    DefaultRequestHandler, JSONRPCHandler) como beans Spring e expomos o endpoint JSON-RPC
    com um @RestController.
  </description>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- Servidor A2A: nucleo independente de framework (nao e Quarkus) -->
    <dependency>
      <groupId>org.a2aproject.sdk</groupId>
      <artifactId>a2a-java-sdk-server-common</artifactId>
    </dependency>
    <dependency>
      <groupId>org.a2aproject.sdk</groupId>
      <artifactId>a2a-java-sdk-transport-jsonrpc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.a2aproject.sdk</groupId>
      <artifactId>a2a-java-sdk-jsonrpc-common</artifactId>
    </dependency>
    <dependency>
      <groupId>org.a2aproject.sdk</groupId>
      <artifactId>a2a-java-sdk-spec</artifactId>
    </dependency>

    <!-- Cliente A2A: usado pelos agentes que chamam outros agentes -->
    <dependency>
      <groupId>org.a2aproject.sdk</groupId>
      <artifactId>a2a-java-sdk-client</artifactId>
    </dependency>
    <dependency>
      <groupId>org.a2aproject.sdk</groupId>
      <artifactId>a2a-java-sdk-client-transport-jsonrpc</artifactId>
    </dependency>

    <!-- O SDK carrega anotacoes CDI (jakarta.enterprise) nos tipos do servidor.
         Nao usamos um container CDI, mas as classes precisam resolver em runtime. -->
    <dependency>
      <groupId>jakarta.enterprise</groupId>
      <artifactId>jakarta.enterprise.cdi-api</artifactId>
    </dependency>
    <dependency>
      <groupId>jakarta.inject</groupId>
      <artifactId>jakarta.inject-api</artifactId>
    </dependency>
  </dependencies>
</project>
